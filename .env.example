# ============================================================================
# TeamHR-Automation Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file with real secrets to version control.
# ============================================================================

# ----------------------------------------------------------------------------
# Application Environment
# ----------------------------------------------------------------------------
# Options: development | test | production
APP_ENV=development

# Host and port the application listens on
APP_HOST=127.0.0.1
APP_PORT=8000

# Secret key for session/signing (change in production!)
SECRET_KEY=change-me-to-a-real-secret

# Directory for generated outputs
OUTPUT_DIR=output

# ----------------------------------------------------------------------------
# Feature Flags
# ----------------------------------------------------------------------------
# Set to true/false or 1/0. All default to false except ADMIN_FEATURE_ENABLED.

# Enable real uploads to eSampark (always false unless testing live)
REAL_UPLOAD_ENABLED=false

# Run eSampark integration in live test mode
ESAMPARK_LIVE_TEST_MODE=false

# Master switch for all communication channels
COMMUNICATION_ENABLED=false

# Individual communication channels
WHATSAPP_ENABLED=false
EMAIL_ENABLED=false
SMS_ENABLED=false
VOICE_ENABLED=false

# Enable admin-only features
ADMIN_FEATURE_ENABLED=true

# Run in demo mode (skip external calls, use mock data)
DEMO_MODE=false

# Show OCR debug views during processing
OCR_DEBUG_VIEW=false

# ----------------------------------------------------------------------------
# Communication - Gupshup (WhatsApp / SMS)
# ----------------------------------------------------------------------------
GUPSHUP_API_KEY=your-gupshup-api-key
GUPSHUP_APP_NAME=your-app-name

# ----------------------------------------------------------------------------
# Communication - Email (SMTP)
# ----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=noreply@example.com

# ----------------------------------------------------------------------------
# Notes
# ----------------------------------------------------------------------------
# - .env is listed in .gitignore and must never be committed with real values.
# - All secrets (API keys, passwords) are excluded from /health responses.
# - See docs/CONFIGURATION.md for full documentation.
