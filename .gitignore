# ============================================================================
# TeamHR Automation - .gitignore
# ============================================================================
# Protect local environments, runtime candidate data, caches, secrets, browser
# state and build output. Required runtime ASSETS (data/masters/*.xlsx,
# data/templates/Excel Generation.xlsx, data/config.json, .env.example) are
# source-controlled and must NOT be ignored.
# ============================================================================

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# --- Secrets / local config ------------------------------------------------
.env
.env.*
!.env.example

# --- Runtime candidate data (never commit) ---------------------------------
data/database/
data/generated/
data/uploads/
data/validation/
data/portal/
data/logs/

# --- Backups (contain DB snapshots - never commit) -------------------------
data/backups/

# --- OCR benchmark images (real Aadhaar - never commit) --------------------
data/ocr_benchmark/input/
data/ocr_benchmark/output/

# --- Logs -------------------------------------------------------------------
logs/
*.log

# --- Temporary / candidate documents and images -----------------------------
tmp/
temp/
candidate_uploads/
candidate_images/

# --- Browser automation state (cookies / auth / sessions) ------------------
playwright/
.browser-state/
storage_state*.json
browser_profiles/

# --- Windows launcher runtime state ----------------------------------------
data/server.pid
data/.deps-installed

# --- Build / release output -------------------------------------------------
release/
build/
dist/
*.spec

# --- OS junk -----------------------------------------------------------------
.DS_Store
Thumbs.db